[Unit]
Description=PUCP Cloud Orchestrator UI
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pucp-cloud-orchestrator
ExecStartPre=/bin/mkdir -p /home/ubuntu/pucp-cloud-orchestrator/logs
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/pucp-cloud-orchestrator/venv/bin/python3 -u -m src.ui.app
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/ubuntu/pucp-cloud-orchestrator/logs/orchestrator.log
StandardError=append:/home/ubuntu/pucp-cloud-orchestrator/logs/orchestrator.log

[Install]
WantedBy=multi-user.target
